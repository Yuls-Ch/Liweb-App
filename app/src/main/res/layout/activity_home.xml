<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".presenter.home.HomeActivity">

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/footer"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="6dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:src="@drawable/icon_app_liweb"
                    tools:ignore="contentDescription" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/my_icon_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/corners_button"
                    android:src="@drawable/sun_icon"
                    android:contentDescription="Modo claro/oscuro" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/my_material_icon_button"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:text="SALIR"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnPrimary"
                    android:fontFamily="@font/poppins_medium"
                    android:backgroundTint="?attr/colorPrimary"
                    android:paddingHorizontal="18dp"
                    android:minWidth="0dp"
                    app:icon="@drawable/exit_icon"
                    app:iconGravity="textEnd"
                    app:iconPadding="8dp"
                    app:iconSize="26dp"
                    app:iconTint="?attr/colorOnPrimary" />

            </LinearLayout>

            <EditText
                android:id="@+id/my_edit_text"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="18dp"
                android:background="?attr/colorSurfaceVariant"
                android:drawableStart="@drawable/search_icon"
                android:drawablePadding="10dp"
                android:fontFamily="@font/poppins_medium"
                android:hint="@string/search_edit_text"
                android:textColorHint="?attr/colorOnSurface"
                android:textColor="?attr/colorOnSurface"
                android:inputType="text"
                android:paddingStart="10dp"
                android:textSize="18sp"
                tools:ignore="RtlSymmetry" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerListBooks"
                android:layout_width="match_parent"
                android:visibility="gone"
                android:layout_height="400dp"
                android:layout_gravity="center"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="12dp"
                tools:listitem="@layout/item_book" />

            <TextView
                android:id="@+id/txtNoResults"
                android:layout_width="match_parent"
                android:layout_height="800dp"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:text="@string/message_no_results"
                android:textSize="25sp"
                android:visibility="gone"
                android:gravity="center"
                android:padding="16dp"/>

            <FrameLayout
                android:id="@+id/frameLayoutHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:paddingBottom="30dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="192dp"
                    android:layout_marginTop="22dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/background_books"
                    android:elevation="0dp"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/txtBienvenida"
                    android:layout_width="match_parent"
                    android:layout_height="47dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="44dp"
                    android:layout_marginEnd="44dp"
                    android:layout_marginBottom="-20dp"
                    android:background="@drawable/corners_text"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="BIENVENIDO DEIVI"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="30sp"
                    android:elevation="8dp" />
            </FrameLayout>

            <GridLayout
                android:id="@+id/gridLayoutHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:alignmentMode="alignMargins"
                android:columnCount="2"
                android:paddingHorizontal="24dp"
                android:rowCount="2"
                android:rowOrderPreserved="false">

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_user_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:clickable="true"
                    android:elevation="6dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <ImageView
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:src="@drawable/avatar_icon"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="PERFIL"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_medium"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_books_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:clickable="true"
                    android:elevation="6dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <ImageView
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:src="@drawable/ic_book_home"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="LIBROS"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_medium"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_favorite_book"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:clickable="true"
                    android:elevation="6dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <ImageView
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:src="@drawable/ic_star_favorite_home"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="FAVORITOS"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_medium"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_top_book"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:clickable="true"
                    android:elevation="6dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <ImageView
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:src="@drawable/ic_top_home"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="TOP LIBROS"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_medium"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </GridLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:clipToPadding="false"
        android:clipChildren="false">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_gravity="bottom"
            android:scaleType="centerCrop"
            android:src="@drawable/desing_lower"
            android:contentDescription="@null" />

        <ImageButton
            android:id="@+id/image_shop_book"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center_horizontal|top"
            android:background="@drawable/button_card_icon"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/icon_cart"
            android:contentDescription="@string/cart_books"
            android:elevation="8dp" />
    </FrameLayout>
</RelativeLayout>
