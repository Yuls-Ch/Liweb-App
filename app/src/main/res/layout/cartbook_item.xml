<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivBookImage"
            android:layout_width="70dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:src="@drawable/item_book_proof"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Contenedor de textos -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="@id/ivBookImage"
            app:layout_constraintBottom_toBottomOf="@id/ivBookImage"
            app:layout_constraintStart_toEndOf="@id/ivBookImage"
            app:layout_constraintEnd_toStartOf="@id/btnDelete"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">

            <!-- Título -->
            <TextView
                android:id="@+id/tvBookTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Harry Potter y la piedra filosofal"
                android:textAlignment="center"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_medium"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvPriceValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PRECIO UNI: S/ 55.00"
                android:textAlignment="center"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvQuantityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CANTIDAD:"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvQuantity"
                    android:layout_width="40dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/stock_background"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Botón de eliminar -->
        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/trash_icon_corners"
            android:padding="8dp"
            android:src="@drawable/trash_icon"
            app:tint="@android:color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
