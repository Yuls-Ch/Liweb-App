<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".presenter.catalogBooks.CatalogBooksActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginTop="15dp"
            android:src="@drawable/icon_app_liweb"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="contentDescription" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/my_icon_button"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/corners_button"
            android:backgroundTint="?attr/colorPrimary"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/change_topic"
            android:src="@drawable/sun_icon"
            app:layout_constraintEnd_toStartOf="@+id/my_material_icon_button"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/my_material_icon_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            app:backgroundTint="?attr/colorPrimary"
            android:text="@string/button_exit_text"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="28sp"
            app:cornerRadius="8dp"
            app:icon="@drawable/exit_icon"
            app:iconGravity="textEnd"
            app:iconSize="25dp"
            app:iconTint="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="105dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_filter"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:layout_marginStart="26dp"
            android:contentDescription="@string/filter_books"
            android:background="@android:color/transparent"
            app:tint="?attr/colorOnTertiary"
            android:src="@drawable/ic_book_filter">
        </ImageButton>

        <EditText
            android:id="@+id/my_edit_text"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginStart="22dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="22dp"
            android:autofillHints="phone"
            android:background="?attr/colorTertiary"
            android:drawableStart="@drawable/search_icon"
            android:drawablePadding="8dp"
            android:drawableTint="?attr/colorOnTertiary"
            android:fontFamily="@font/poppins_medium"
            android:hint="@string/search_edit_text"
            android:includeFontPadding="false"
            android:inputType="text"
            android:paddingStart="16dp"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:ignore="RtlSymmetry" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="44dp"
        android:layout_marginEnd="44dp"
        android:layout_marginBottom="-20dp"
        android:background="@drawable/corners_text"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:text="@string/book_title"
        android:textColor="@color/white"
        android:textSize="30sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_weight="0" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerListBooks"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_gravity="center"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp"
        tools:listitem="@layout/item_book" />

    <TextView
        android:id="@+id/txtNoResults"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:text="@string/message_no_results"
        android:textSize="25sp"
        android:visibility="gone"
        android:gravity="center"
        android:padding="16dp"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="9dp"
        android:layout_weight="0" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingTop="3dp">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/desing_lower"
            android:contentDescription="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/image_shop_book"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:layout_marginTop="-1dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/button_card_icon"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/icon_cart"
            android:contentDescription="@string/cart_books"
            app:layout_constraintBottom_toBottomOf="@+id/imageView2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent" />
    </FrameLayout>
</LinearLayout>