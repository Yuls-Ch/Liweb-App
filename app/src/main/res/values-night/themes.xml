<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MyApplication" parent="Theme.Material3.Dark.NoActionBar">

        <item name="colorPrimary">@color/blue_strong</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/dark_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorTertiary">@color/gray_surface</item>
        <item name="colorOnTertiary">@color/gray_2000</item>
        <item name="android:textColorPrimary">@color/white</item>

        <item name="android:colorBackground">@color/dark_gray_bg</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="containerColor">@color/blue_strong</item>

        <item name="colorSurface">@color/gray_surface</item>
        <item name="colorSurfaceVariant">@color/gray_surface_variant</item>
        <item name="colorOnSurface">@color/white</item>

        <item name="colorOutline">@color/gray_outline</item>

        <item name="materialButtonStyle">@style/Widget.MyApp.Button</item>
        <item name="materialCardViewStyle">@style/Widget.MyApp.Card</item>
        <item name="colorButtonNormal">@color/dark_blue_swamp</item>
    </style>

    <style name="Widget.MyApp.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.MyApp.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="android:strokeColor">?attr/colorOutline</item>
        <item name="android:strokeWidth">1.0</item>
    </style>

</resources>
