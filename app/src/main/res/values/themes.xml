<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema claro -->
    <style name="Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
    <!-- Colores principales -->
        <item name="colorPrimary">@color/blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/dark_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorTertiary">@color/grey</item>
        <item name="colorOnTertiary">@color/black</item>
        <item name="android:textColorPrimary">@color/gray_3000</item>

        <!-- Fondo general -->
        <item name="android:colorBackground">@color/white</item>
        <item name="colorOnBackground">@color/black</item>
        <item name="containerColor">@color/white</item>

        <!-- Superficies y tarjetas -->
        <item name="colorSurface">@color/gray_detail</item>
        <item name="colorOnSurface">@color/black</item>

        <!-- Botones Material -->
        <item name="materialButtonStyle">@style/Widget.MyApp.Button</item>
        <item name="materialCardViewStyle">@style/Widget.MyApp.Card</item>
        <item name="colorButtonNormal">@color/blue_swamp</item>
    </style>

    <!-- Botón personalizado -->
    <style name="Widget.MyApp.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- CardView personalizado -->
    <style name="Widget.MyApp.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">8dp</item>
    </style>

</resources>
